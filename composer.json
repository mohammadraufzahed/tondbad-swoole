{
  "name": "mohammadraufzahed/tondbad-swoole",
  "description": "Tondbād - A lightweight and high-performance PHP framework built on OpenSwoole with routing, job workers, queue management, and gRPC support.",
  "type": "library",
  "keywords": [
    "openswoole",
    "php",
    "framework",
    "routing",
    "job workers",
    "queue",
    "grpc",
    "performance"
  ],
  "license": "MIT",
  "bin": [
    "bin/tondbad"
  ],
  "autoload": {
    "psr-4": {
      "TondbadSwoole\\": "src/"
    },
    "files": [
      "src/Support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "TondbadSwoole\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Mohammad Raufzahed",
      "email": "mohammadraufzahed@protonmail.com"
    }
  ],
  "scripts": {
    "server": "php bin/tondbad serve",
    "grpc": "php bin/tondbad serve:grpc",
    "test": "pest",
    "compile-proto": [
      "sh -c 'protoc $(find ./protos -name \"*.proto\") --proto_path=./protos --php_out=./generated --openswoole-grpc_out=./generated --plugin=protoc-gen-openswoole-grpc=$(which protoc-gen-openswoole-grpc)'"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.2",
    "ext-openswoole": "*",
    "nikic/fast-route": "^2.0@dev",
    "monolog/monolog": "^3.0",
    "grpc/grpc": "^1.57",
    "google/protobuf": "^3.25",
    "openswoole/core": "^22.1.5",
    "openswoole/grpc": "^22.1.5",
    "symfony/serializer": "^7.2",
    "symfony/property-access": "^7.2",
    "predis/predis": "^2.3",
    "vlucas/phpdotenv": "^5.6",
    "psr/simple-cache": "^3.0"
  },
  "require-dev": {
    "pestphp/pest": "^5.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
