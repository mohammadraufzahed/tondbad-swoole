#!/usr/bin/env php
<?php

declare(strict_types=1);

use TondbadSwoole\Bootstrap\AppFactory;
use TondbadSwoole\Console\Application;

$autoloadFiles = [
    getcwd() . '/vendor/autoload.php',
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$autoloadFound = false;

foreach ($autoloadFiles as $file) {
    if (file_exists($file)) {
        require $file;
        $autoloadFound = true;
        break;
    }
}

if (!$autoloadFound) {
    fwrite(STDERR, "Could not locate vendor/autoload.php\n");
    exit(1);
}

$basePath = getcwd() ?: dirname(__DIR__);

$app = AppFactory::create($basePath);
$app->boot();

$console = $app->container->make(Application::class);

exit($console->run($argv));
